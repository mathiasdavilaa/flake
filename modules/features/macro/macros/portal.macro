# macro: portal (+ apelidos: portaldesktop, portallaptop — nomes
# antigos, mantidos por compatibilidade)

# medido no desktop, 1920x1080, monitor DP-3
PORTAL_REF="1920x1080"
PORTAL_POSITIONS=(
    "955 275"
    "390 555"
    "610 790"
    "700 370"
    "1250 780"
)

# medido à mão no laptop (1920x1200); apague pra deixar o
# reescalonamento automático cuidar disso.
PORTAL_POSITIONS_1920x1200=(
    "980 300"
    "400 611"
    "600 850"
    "700 411"
    "1250 850"
)

MACRO_ALIASES+=(
    [portal]=PORTAL
    [portaldesktop]=PORTAL
    [portallaptop]=PORTAL
)
