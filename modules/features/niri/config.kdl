// niri NÃO mescla o binds{} daqui com o padrão dele: o que não
// estiver escrito aqui simplesmente não existe. Por isso esse
// arquivo tem tanto os binds "de fábrica" importantes (sair,
// overlay de atalhos, destravar input) quanto os portados do
// mango/binds.conf. O resto do arquivo (input, layout, etc) o
// niri já preenche com padrão razoável se você omitir a seção.
//
// SHELL: DMS (DankMaterialShell) é o instalado/habilitado pro niri
// (default.nix desta feature). Os binds abaixo ainda chamam
// `noctalia msg ...` — funcionam se você optar por rodar noctalia
// no niri também, mas rodar os dois AO MESMO TEMPO duplica
// barra/painel. Decida qual quer ativo e ajusta spawn-at-startup +
// os binds de acordo.

// xwayland-satellite: desde a 25.08 o niri sobe sozinho, sob
// demanda, quando um app X11 conecta — só precisa do binário no
// PATH (modules/wm/niri.nix já garante isso). Nada a fazer aqui.

prefer-no-csd

// NÃO CONFIRMADO: não achei o comando exato de autostart do DMS
// documentado (varia por versão — pode ser `dms run`, `qs -c dms`
// ou o shell já subir sozinho via systemd ao habilitar o módulo).
// Teste com `dms run` manual num terminal primeiro; se funcionar,
// descomenta a linha abaixo. Se o módulo já subir sozinho (verifique
// com `systemctl --user status` depois do primeiro login), apague.
// spawn-at-startup "dms" "run"

// ponte do text-input-v3 (veja o comentário em modules/common.nix
// — provável causa do bug "não digita nada" no Sober/mango; niri
// nunca teve IME configurado também, mesma lógica se aplica aqui)
spawn-at-startup "fcitx5"

input {
    keyboard {
        xkb {
            layout "us,br"
            options "caps:escape"
        }
        repeat-delay 400
        repeat-rate 30
    }

    // ATENÇÃO — trade-off real, sem solução limpa hoje: o niri
    // (diferente do mango) não configura dispositivo por
    // dispositivo, então isso vale pra TODO mouse, incluindo o seu
    // de verdade, não só o cursor virtual do ydotool. Escolhi
    // "flat"/sem aceleração porque o sistema de macro (click_at_niri)
    // depende de deltas relativos previsíveis pra acertar o pixel —
    // com aceleração ligada, o mesmo delta pode terminar em lugares
    // diferentes dependendo da "velocidade" do movimento sintético.
    // Se preferir manter aceleração normal no seu mouse de verdade
    // (jogos em geral preferem "flat" de qualquer forma, mas é sua
    // escolha), troque pra "adaptive" aqui e aceite que os cliques
    // do macro no niri podem sair menos precisos.
    mouse {
        accel-profile "flat"
    }

    touchpad {
        scroll-method "two-finger"
    }
}

layout {
    gaps 8

    focus-ring {
        width 2
    }
}

binds {
    // --- essenciais do niri (não existem no mango, mas evitam
    // ficar sem funcionalidade básica) ---
    Mod+Shift+Slash { show-hotkey-overlay; }
    Mod+Shift+E { quit; }
    Mod+Escape allow-inhibiting=false { toggle-keyboard-shortcuts-inhibit; }
    Mod+O repeat=false { toggle-overview; }
    Mod+S { screenshot; }
    Ctrl+Print { screenshot-screen; }

    // --- Main binds (mango: SUPER,w / q / e) ---
    Mod+W hotkey-overlay-title="Abrir terminal: ghostty" { spawn "ghostty"; }
    Mod+Q { close-window; }
    Mod+E { spawn "ghostty" "--title=Yazi" "-e" "yazi"; }

    // --- Noctalia (idêntico ao mango: só spawna comando, não
    // depende do compositor) ---
    Mod+D { spawn "noctalia" "msg" "panel-toggle" "launcher"; }
    Mod+F2 { spawn "noctalia" "msg" "panel-toggle" "clipboard"; }
    Mod+Escape { spawn "noctalia" "msg" "panel-toggle" "session"; }
    Mod+F1 { spawn "noctalia" "msg" "panel-toggle" "kenn/keybind-cheatsheet:cheatsheet"; }
    Print { spawn "noctalia" "msg" "screenshot-region"; }
    XF86AudioRaiseVolume     allow-when-locked=true { spawn "noctalia" "msg" "volume-up"; }
    XF86AudioLowerVolume     allow-when-locked=true { spawn "noctalia" "msg" "volume-down"; }
    XF86AudioMute            allow-when-locked=true { spawn "noctalia" "msg" "volume-mute"; }
    XF86MonBrightnessUp      allow-when-locked=true { spawn "noctalia" "msg" "brightness-up"; }
    XF86MonBrightnessDown    allow-when-locked=true { spawn "noctalia" "msg" "brightness-down"; }

    // --- Window ---
    // mango tinha dois níveis: togglefullscreen (exclusivo, sem
    // decoração nenhuma — o que os jogos precisam) e set_proportion
    // 1.0 (coluna ocupando a largura toda, mas ainda tiled). No
    // niri isso vira fullscreen-window e maximize-column.
    Mod+Shift+F { fullscreen-window; }
    Mod+F { maximize-column; }
    Mod+V { toggle-window-floating; }

    // resize: mango usava pixels fixos (±150px); no niri o idioma
    // é por porcentagem da coluna.
    Mod+Equal { set-column-width "+10%"; }
    Mod+Minus { set-column-width "-10%"; }
    Mod+Prior { set-column-width "50%"; }
    Mod+Next  { set-column-width "80%"; }

    // --- Navigation ---
    // já é literalmente o bind padrão do niri — só troquei pra
    // manter os seus hjkl + setas.
    Mod+H     { focus-column-left; }
    Mod+Left  { focus-column-left; }
    Mod+L     { focus-column-right; }
    Mod+Right { focus-column-right; }
    Mod+K     { focus-window-up; }
    Mod+Up    { focus-window-up; }
    Mod+J     { focus-window-down; }
    Mod+Down  { focus-window-down; }

    // exchange_client do mango -> mover coluna/janela no niri
    Mod+Shift+H     { move-column-left; }
    Mod+Shift+Left  { move-column-left; }
    Mod+Shift+L     { move-column-right; }
    Mod+Shift+Right { move-column-right; }
    Mod+Shift+K     { move-window-up; }
    Mod+Shift+Up    { move-window-up; }
    Mod+Shift+J     { move-window-down; }
    Mod+Shift+Down  { move-window-down; }

    // workspaces numerados (mango: view / tag / tagsilent)
    Mod+1 { focus-workspace 1; }
    Mod+2 { focus-workspace 2; }
    Mod+3 { focus-workspace 3; }
    Mod+4 { focus-workspace 4; }
    Mod+5 { focus-workspace 5; }
    Mod+6 { focus-workspace 6; }
    Mod+7 { focus-workspace 7; }
    Mod+8 { focus-workspace 8; }
    Mod+9 { focus-workspace 9; }

    // SUPER+SHIFT+N no mango = manda a janela E segue (tag)
    Mod+Shift+1 { move-window-to-workspace 1; }
    Mod+Shift+2 { move-window-to-workspace 2; }
    Mod+Shift+3 { move-window-to-workspace 3; }
    Mod+Shift+4 { move-window-to-workspace 4; }
    Mod+Shift+5 { move-window-to-workspace 5; }
    Mod+Shift+6 { move-window-to-workspace 6; }
    Mod+Shift+7 { move-window-to-workspace 7; }
    Mod+Shift+8 { move-window-to-workspace 8; }
    Mod+Shift+9 { move-window-to-workspace 9; }

    // SUPER+CTRL+N no mango = manda a janela SEM seguir (tagsilent)
    Mod+Ctrl+1 { move-window-to-workspace 1 focus=false; }
    Mod+Ctrl+2 { move-window-to-workspace 2 focus=false; }
    Mod+Ctrl+3 { move-window-to-workspace 3 focus=false; }
    Mod+Ctrl+4 { move-window-to-workspace 4 focus=false; }
    Mod+Ctrl+5 { move-window-to-workspace 5 focus=false; }
    Mod+Ctrl+6 { move-window-to-workspace 6 focus=false; }
    Mod+Ctrl+7 { move-window-to-workspace 7 focus=false; }
    Mod+Ctrl+8 { move-window-to-workspace 8 focus=false; }
    Mod+Ctrl+9 { move-window-to-workspace 9 focus=false; }

    // focusmon/tagmon do mango (só tinha bind pra direita)
    Mod+End       { focus-monitor-right; }
    Mod+Shift+End { move-window-to-monitor-right; }
    // mango tinha um script à parte (move-window-right-silent.sh,
    // via mmsg) só pra mover SEM focar — o niri já faz isso nativo:
    Mod+Ctrl+End  { move-window-to-monitor-right focus=false; }

    // --- SCRIPT (idêntico ao mango: macro-toggle não sabe nem
    // precisa saber qual compositor está rodando) ---
    Mod+F8 { spawn "macro-toggle" "portal"; }
}
